# Fork-layer Dockerfile for kokoro-tts-server (CPU flavour).
#
# Layers our minimal additions on top of the upstream
# `docker/cpu/Dockerfile` build steps. Inlined here so a single image
# is produced; matches the parallel `Dockerfile.gpu` layout 1:1 so
# rebases against upstream only touch the two files together.
#
# What we add over upstream:
#   - ALLOW_LOCAL_VOICE_SAVING=true ENV default
#   - MinIO Python SDK
#   - server_addons/ (sync + reload + save-combined routes + lifespan sync)
#   - CMD switches to `server_addons.main:app`

FROM python:3.10-slim

# Upstream system deps. Rust is required to build sudachipy /
# pyopenjtalk-plus from source on slim.
RUN apt-get update -y && \
    apt-get install -y espeak-ng espeak-ng-data git libsndfile1 curl ffmpeg g++ cmake && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    mkdir -p /usr/share/espeak-ng-data && \
    ln -s /usr/lib/*/espeak-ng-data/* /usr/share/espeak-ng-data/ && \
    curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/ && \
    mv /root/.local/bin/uvx /usr/local/bin/ && \
    useradd -m -u 1001 appuser && \
    mkdir -p /app/api/src/models/v1_0 && \
    chown -R appuser:appuser /app

USER appuser
WORKDIR /app

# Install Rust for the non-root user so builds (e.g., sudachipy) succeed.
RUN curl https://sh.rustup.rs -sSf | sh -s -- -y

# Ensure Cargo and the Python venv are on PATH; extend HTTP timeouts for uv.
ENV PATH="/home/appuser/.cargo/bin:/app/.venv/bin:$PATH" \
    UV_HTTP_TIMEOUT=120 \
    UV_HTTP_RETRIES=3

COPY --chown=appuser:appuser pyproject.toml ./pyproject.toml

RUN uv venv --python 3.10 && \
    uv sync --extra cpu --no-cache && \
    uv pip install --no-cache-dir "minio>=7.2"

ARG INCLUDE_JAPANESE=true
RUN if [ "$INCLUDE_JAPANESE" = "true" ]; then \
        uv run python -m unidic download; \
    fi

# Upstream sources + our addons.
COPY --chown=appuser:appuser api ./api
COPY --chown=appuser:appuser web ./web
COPY --chown=appuser:appuser docker/scripts/ ./
COPY --chown=appuser:appuser server_addons ./server_addons

# Stage baked voicepacks so a runtime bind mount on
# /app/api/src/voices/v1_0 does not mask the upstream voicepacks
# shipped in the image. The rewritten entrypoint copies any baked
# voicepack the mount does not already provide.
RUN cp -a /app/api/src/voices/v1_0 /app/voices-baked

# Rewrite entrypoint:
#   1. seed mounted voices_dir from /app/voices-baked (no-clobber)
#   2. download the Kokoro model if asked (upstream behaviour)
#   3. launch our wrapped app via uv
RUN printf '%s\n' \
    '#!/bin/bash' \
    'set -e' \
    '' \
    'mkdir -p /app/api/src/voices/v1_0' \
    'cp -an /app/voices-baked/. /app/api/src/voices/v1_0/' \
    '' \
    'if [ "$DOWNLOAD_MODEL" = "true" ]; then' \
    '    python download_model.py --output api/src/models/v1_0' \
    'fi' \
    '' \
    'exec uv run --extra "$DEVICE" --no-sync python -m uvicorn server_addons.main:app --host 0.0.0.0 --port 8880 --log-level debug' \
    > ./entrypoint.sh && chmod +x ./entrypoint.sh

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/api \
    UV_LINK_MODE=copy \
    USE_GPU=false \
    PHONEMIZER_ESPEAK_PATH=/usr/bin \
    PHONEMIZER_ESPEAK_DATA=/usr/share/espeak-ng-data \
    ESPEAK_DATA_PATH=/usr/share/espeak-ng-data \
    DEVICE="cpu" \
    ALLOW_LOCAL_VOICE_SAVING=true \
    MINIO_BUCKET=tts-training \
    MINIO_VOICEPACK_PREFIX=voicepacks/ \
    MINIO_SECURE=false \
    KOKORO_SYNC_ON_START=0

ENV DOWNLOAD_MODEL=true
RUN if [ "$DOWNLOAD_MODEL" = "true" ]; then \
    python download_model.py --output api/src/models/v1_0; \
    fi

EXPOSE 8880

CMD ["./entrypoint.sh"]
