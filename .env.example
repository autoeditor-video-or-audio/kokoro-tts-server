# kokoro-tts-server — shared .env for docker-compose.gpu.prod.yml AND
# docker-compose.cpu.prod.yml. Copy to .env and edit on the target host.
#
# Pick the matching compose file at run time:
#   GPU host: docker compose --env-file .env -f docker-compose.gpu.prod.yml up -d
#   CPU host: docker compose --env-file .env -f docker-compose.cpu.prod.yml up -d
#
# GHCR image tag. Use `latest-gpu` for the CUDA image (NVIDIA host) or
# `latest-cpu` for the slim Python image (any x86_64 host).
KOKORO_IMAGE_TAG=latest-gpu

# Listen port (host -> container 8880). Keep 8880 to stay drop-in
# compatible with the upstream remsky/Kokoro-FastAPI container.
KOKORO_PORT=8880

# Enables POST /v1/audio/voices/combine (upstream blend route) plus
# POST /v1/voices/save-combined (fork-only weighted-blend persistence).
# The fork defaults this to true; flip to false to fall back to
# upstream's strict 403 behaviour.
ALLOW_LOCAL_VOICE_SAVING=true

# If 1/true, the lifespan hook pulls voicepacks from MinIO at boot.
KOKORO_SYNC_ON_START=0

# MinIO endpoint. Default points at the k8s NodePort exposed at
# 192.168.15.152:30002 (svc minio/svce-minio-api).
MINIO_ENDPOINT=192.168.15.152:30002

MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=MinioS3Success

MINIO_BUCKET=tts-training
MINIO_VOICEPACK_PREFIX=voicepacks/
MINIO_SECURE=false
